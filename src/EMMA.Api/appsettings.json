{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Emma": {
    "Api": {
      "KeyHeader": "x-api-key",
      "RateLimit": {
        "PerClientPermits": 60,
        "PerClientWindowSeconds": 60,
        "GlobalConcurrency": 64,
        "GlobalQueue": 0
      }
    },
    "Trust": {
      "RequireSigned": true
    }
  }
}
