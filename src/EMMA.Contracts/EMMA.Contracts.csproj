<Project Sdk="Microsoft.NET.Sdk">
  <!--
    wit/*.wit and plugin-manifest.schema.json are the contract. They are consumed in three places, so none is only
    validated by hand: the Wasm host compiles the whole WIT package into its bindings (native/emma-wasm), the CLI
    embeds the WIT and the plugin template (EMMA.Cli.csproj), and `cargo test` in native/emma-wasm parses the package
    (tests/contract.rs: version, worlds, exports) while ManifestSchemaTests keeps the schema in step with the manifest
    writer. check.sh and CI run both. Nothing needs the files at run time, so nothing packages them for the host.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
</Project>
