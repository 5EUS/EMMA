<Project Sdk="Microsoft.NET.Sdk">
  <!--
    TODO(rewrite): main's initial schema also had `plugins`, `plugin_failures`,
    `media_migration_candidates` and `media_migration_map` tables. The plugin registry and
    failure log belong with the plugin host (phase 4). The migration tables backed a feature
    that moved a library entry from one plugin to another by matching titles; it is not
    ported, and would be rebuilt on NodeRef (map old ref to new ref) if it is still wanted.
  -->
  <!--
    TODO(rewrite): NativeAOT and SQLite. Verified on linux-x64 (2026-11-07): a NativeAOT
    publish of a console app using this project has no IL warnings, ships libe_sqlite3.so
    beside the binary, and runs migrations, typed props and queries correctly. Still to
    verify in phase 8: the other desktop RIDs, and iOS and Android, which need the matching
    SQLitePCLRaw static or per-ABI libraries.
  -->
  <!--
    TODO(rewrite): the default database path (main read EMMA_STORAGE_DATABASE_PATH inside
    StorageOptions) is deliberately gone. The host resolves configuration and passes the path in.
  -->
  <ItemGroup>
    <ProjectReference Include="../EMMA.Application/EMMA.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fixed logical names: independent of the folder layout and root namespace. -->
    <EmbeddedResource Include="Sql/*.sql" LogicalName="EMMA.Storage.Sql.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
</Project>
