<Project Sdk="Microsoft.NET.Sdk">
  <!--
    TODO(rewrite): main's initial schema also had `media_migration_candidates` and `media_migration_map` tables. They
    backed a feature that moved a library entry from one plugin to another by matching titles; it is not ported, and
    is rebuilt on NodeRef (map old ref to new ref) in the migrations work. main's `plugin_failures` table is gone on
    purpose: failures are reported through IPluginLogPort and a failing plugin is quarantined in memory, so there is
    nothing to persist.
  -->
  <!--
    TODO(rewrite): NativeAOT and SQLite. Verified on linux-x64 (2026-11-07): a NativeAOT
    publish of a console app using this project has no IL warnings, ships libe_sqlite3.so
    beside the binary, and runs migrations, typed props and queries correctly. Still to
    verify in phase 8: the other desktop RIDs, and iOS and Android, which need the matching
    SQLitePCLRaw static or per-ABI libraries.
  -->
  <!--
    There is no default database path. main read EMMA_STORAGE_DATABASE_PATH inside StorageOptions; now every host
    resolves its own data directory and EmmaRuntime puts the database at <data>/emma.db (docs/architecture/native-abi.md).
  -->
  <PropertyGroup>
    <!-- SqliteNativeLibrary loads SQLite with dlopen (RTLD_DEEPBIND) through a source-generated P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EMMA.Application/EMMA.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fixed logical names: independent of the folder layout and root namespace. -->
    <EmbeddedResource Include="Sql/*.sql" LogicalName="EMMA.Storage.Sql.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
</Project>
