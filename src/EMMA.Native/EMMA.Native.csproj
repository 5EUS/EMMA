<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The in-process C ABI for apps that embed EMMA (Flutter via dart:ffi, or any C caller). It is a thin shell:
    one dispatching call over the same pipelines the HTTP API uses, JSON in and out with the same shapes. See
    docs/architecture/native-abi.md. The ABI is versioned by emma_abi_version(); new operations are new
    operation names, never new exports.

    Desktop targets are published and checked on their own platforms (scripts/publish-native.sh, with the C smoke test).
    Android (a shared library, built with the NDK) and iOS (a static library) come out of the same script and are
    bundled by scripts/package-android.sh and scripts/package-ios.sh; CI builds both.

    TODO(rewrite): nothing mobile has run on a device. The Android libraries are built and checked (exports, 16 KiB
    alignment, bionic-only dependencies) but not loaded; the iOS script and the DirectPInvoke below have never run
    (they need a Mac). The Wasm host's iOS path (pulley) is likewise unverified: LazyWasmTransport passes
    WasmRuntimeOptions("pulley64") on iOS, but it has not run on a device, and SQLite on iOS (the system library through
    SQLitePCLRaw.provider.sqlite3, not libe_sqlite3) is not wired. Do those together with the first device run.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <!--
    The mobile scripts choose Static (iOS) or Shared through EmmaNativeLib, not NativeLib: a global NativeLib reaches every
    referenced project, and with an ios rid it turns each of them (EMMA.Domain, ...) into an Exe that fails to build.
  -->
  <PropertyGroup Condition="'$(EmmaNativeLib)' != ''">
    <NativeLib>$(EmmaNativeLib)</NativeLib>
  </PropertyGroup>
  <!--
    On iOS the Wasm host is a static library linked into the app, not a library found at run time: bind its P/Invokes
    at link time. The symbols stay undefined in libemma_native.a and are resolved when the app links libemma_wasm.a.
  -->
  <ItemGroup Condition="$(EmmaMobileRid.StartsWith('ios'))">
    <DirectPInvoke Include="emma_wasm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EMMA.Runtime/EMMA.Runtime.csproj" />
    <ProjectReference Include="../EMMA.Api.Contracts/EMMA.Api.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EMMA.Native.Tests" />
  </ItemGroup>
  <!--
    The Wasm host ships beside the library. A missing one is not a build error: the library still lists and
    configures plugins, and says what is missing when a plugin is first opened.
  -->
  <PropertyGroup>
    <NativeArtifacts>$(MSBuildThisFileDirectory)../../artifacts/native/</NativeArtifacts>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NativeArtifacts)lib/*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
