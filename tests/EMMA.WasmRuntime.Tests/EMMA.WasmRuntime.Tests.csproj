<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test assemblies are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <!-- Tests are not published AOT; they exercise the same code the AOT build ships. -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <NativeArtifacts>$(MSBuildThisFileDirectory)../../artifacts/native/</NativeArtifacts>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/EMMA.WasmRuntime/EMMA.WasmRuntime.csproj" />
    <ProjectReference Include="../../src/EMMA.PluginHost/EMMA.PluginHost.csproj" />
    <ProjectReference Include="../EMMA.TestSupport/EMMA.TestSupport.csproj" />
    <ProjectReference Include="../EMMA.PluginConformance/EMMA.PluginConformance.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <!--
    These tests drive the real native host and real Wasm components, never a fake. A missing artifact is
    a failed build, not a skipped test: a silent skip would let the whole integration layer rot unseen.
    Produce them with `sh native/build-host.sh` and `sh native/build-plugins.sh` (check.sh does both).
  -->
  <Target Name="RequireNativeArtifacts" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <NativeHostFile Include="$(NativeArtifacts)lib/*" />
    </ItemGroup>
    <Error Condition="'@(NativeHostFile)' == ''"
           Code="EMMA0001"
           Text="The native Wasm host is not built. Run: sh native/build-host.sh and sh native/build-plugins.sh" />
  </Target>
  <ItemGroup>
    <None Include="$(NativeArtifacts)lib/*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
