<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test assemblies are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <!-- Tests are not published AOT; they exercise the same code the AOT build ships. -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/EMMA.Domain/EMMA.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the Rust host (native/emma-wasm), so both sides of the network allow-list agree. -->
    <None Include="../../native/emma-wasm/tests/vectors/network-policy.json" Link="vectors/network-policy.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
</Project>
