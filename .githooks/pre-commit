#!/usr/bin/env sh
# Fast checks only. The slow ones (build, tests) belong in CI and in
# scripts/development/check.sh — a pre-commit hook people disable is worse than
# no hook at all.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"

if command -v dotnet >/dev/null 2>&1; then
  dotnet format whitespace --no-restore --verify-no-changes
fi
